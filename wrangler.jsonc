{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beavieweb",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  // Static site served straight from the repo root.
  // Files that must NOT be published are listed in .assetsignore.
  "assets": {
    "directory": "."
  }
}
